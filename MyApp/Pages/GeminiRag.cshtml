<!-- ───────────────────────── Many sources, one assistant ───────────────────────── -->
<div class="relative isolate overflow-hidden bg-slate-900 py-20 dark:bg-slate-950">

    <svg class="absolute inset-0 -z-10 h-full w-full stroke-white/10 [mask-image:radial-gradient(80%_60%_at_50%_0%,white,transparent)]" aria-hidden="true">
        <defs>
            <pattern id="fanin-grid" width="120" height="120" x="50%" y="-1" patternUnits="userSpaceOnUse">
                <path d="M60 120V.5M.5 .5H120" fill="none" />
            </pattern>
        </defs>
        <rect width="100%" height="100%" stroke-width="0" fill="url(#fanin-grid)" />
    </svg>
    <div class="absolute left-1/2 top-1/3 -z-10 h-[32rem] w-[52rem] -translate-x-1/2 rounded-full bg-emerald-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            <p class="font-mono text-xs font-bold uppercase tracking-widest text-emerald-400">One knowledge base</p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
                Every site you maintain.<br class="hidden sm:inline"> One Assistant that knows them all.
            </h2>
            <p class="mt-4 text-lg leading-8 text-slate-300">
                A File Store isn't tied to a single website. Point as many imports as you like at it - docs repos,
                blog posts, Razor marketing pages, product sites you only have the HTML of - and every one of them
                lands in the same catalogue, behind <span class="font-semibold text-white">one Assistant</span> and
                <span class="font-semibold text-white">one Search box</span>.
            </p>
        </div>

        <!-- Fan-in / fan-out diagram -->
        <div class="mx-auto mt-16 max-w-5xl">
            <p class="text-center font-mono text-[11px] font-bold uppercase tracking-widest text-slate-500">5 imports</p>
            <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
                <div class="rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
                    <div class="font-mono text-[10px] font-bold uppercase tracking-widest text-emerald-400">Folder</div>
                    <div class="mt-2 truncate font-mono text-sm font-semibold text-white" title="servicestack.net">servicestack.net</div>
                    <div class="mt-1 text-xs text-slate-400">Blog posts &middot; <span class="text-slate-300">98 docs</span></div>
