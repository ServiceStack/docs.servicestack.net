                    <div class="mt-6 flex flex-wrap gap-2">
                        <span class="rounded-full bg-emerald-500/10 px-3 py-1 font-mono text-xs font-semibold text-emerald-700 dark:text-emerald-400">added</span>
                        <span class="rounded-full bg-amber-500/10 px-3 py-1 font-mono text-xs font-semibold text-amber-700 dark:text-amber-400">updated</span>
