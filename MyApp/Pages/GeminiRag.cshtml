@page "/rag"
@attribute [RenderStatic]

@{
    ViewData["Title"] = "Gemini RAG";
    ViewData["AiNav"] = "rag";
    ViewData["Brand"] = "ServiceStack.AI.Chat";
}

<link rel="stylesheet" href="/css/lite-yt-embed.css">
<script src="/lib/js/lite-yt-embed.js"></script>

<style>
    /* The split in the pipeline diagram: one source of content feeding two destinations */
    .flow { position: relative; overflow: hidden }
    .flow::after {
        content: ""; position: absolute; inset: 0;
        background: linear-gradient(90deg, transparent, rgb(45 212 191 / .7), transparent);
        background-size: 220% 100%;
        animation: flow-run 3s linear infinite;
    }
    .flow-b::after { animation-delay: 1.5s }
    @@keyframes flow-run {
        from { background-position: 220% 0 }
        to   { background-position: -120% 0 }
    }
    @@media (max-width: 1023px) {
        .flow::after {
            background: linear-gradient(180deg, transparent, rgb(45 212 191 / .7), transparent);
            background-size: 100% 220%;
            animation-name: flow-run-y;
        }
        @@keyframes flow-run-y {
            from { background-position: 0 220% }
            to   { background-position: 0 -120% }
        }
    }
    @@media (prefers-reduced-motion: reduce) {
        .flow::after { animation: none; background: rgb(45 212 191 / .45) }
    }

    /* Sources converging into one File Store, then fanning out to Assistant + Search */
    .converge path, .diverge path {
        stroke-dasharray: 6 10;
        animation: converge-run 1.6s linear infinite;
    }
    @@keyframes converge-run {
        to { stroke-dashoffset: -32 }
    }
    @@media (prefers-reduced-motion: reduce) {
        .converge path, .diverge path { animation: none; stroke-dasharray: none; opacity: .5 }
    }
</style>

@await Html.PartialAsync("AiNav")

<!-- ───────────────────────── Hero ───────────────────────── -->
<div class="relative isolate overflow-hidden border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">

    <svg class="absolute inset-0 -z-10 h-full w-full stroke-slate-200 [mask-image:radial-gradient(90%_70%_at_top,white,transparent)] dark:stroke-slate-800/60" aria-hidden="true">
        <defs>
            <pattern id="rag-grid" width="120" height="120" x="50%" y="-1" patternUnits="userSpaceOnUse">
                <path d="M60 120V.5M.5 .5H120" fill="none" />
            </pattern>
        </defs>
        <rect width="100%" height="100%" stroke-width="0" fill="url(#rag-grid)" />
    </svg>

    <div class="mx-auto max-w-7xl px-6 pt-16 pb-16 sm:pt-20 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            <div class="flex justify-center">
                <div class="rounded-full px-3 py-1 font-mono text-xs tracking-tight text-slate-600 ring-1 ring-slate-900/10 dark:text-slate-400 dark:ring-white/10">
                    Gemini RAG + Website Search
                </div>
            </div>

            <h1 class="mt-6 text-4xl font-black tracking-tight text-slate-900 sm:text-6xl dark:text-white">
                <span class="mb-4 block">Your documents.</span>
                <span class="bg-gradient-to-r from-emerald-500 to-teal-500 bg-clip-text text-transparent dark:from-emerald-400 dark:to-teal-400">Answers you can verify.</span>
            </h1>

            <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
                Import files, folders and entire websites into managed knowledge bases, then publish two grounded
                experiences from the same content - a citation-backed AI Assistant and instant site search that
                never calls a model.
            </p>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
                <a href="/chat/gemini-rag" class="rounded-md bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-emerald-500">
                    Get Started
                </a>
                <a href="/chat/" class="text-sm font-semibold leading-6 text-slate-900 transition-colors hover:text-emerald-600 dark:text-white dark:hover:text-emerald-400">
                    See AI Chat <span aria-hidden="true">&rarr;</span>
                </a>
            </div>

            <div class="my-8 mx-auto max-w-lg" data-component="ShellCommand" data-props="{text:'npx add-in chat'}"></div>
        </div>

        <div class="group relative mx-auto mt-6 max-w-6xl">
            <div class="absolute -inset-3 rounded-3xl bg-gradient-to-r from-emerald-400 via-teal-400 to-cyan-400 opacity-25 blur-2xl dark:opacity-20"></div>
            <div class="relative overflow-hidden rounded-xl border border-slate-200 shadow-2xl dark:border-slate-700 dark:bg-white">
                <img src="/img/pages/chat/gemini/gemini-42-assistant-behavior.webp" alt="A Gemini File Store with its Explore, Import, Assistants and Search workspaces" class="h-auto w-full">
            </div>
        </div>
    </div>
</div>

<!-- ───────────────────────── Video series ───────────────────────── -->
@{
    // Temporarily disabled whilst the latest video is scheduled for publishing (set to true to re-enable)
    var showVideos = false;
    // Add each new video in the series here; tabs and panels are generated from this list
    var videos = new[] {
        new {
            Id = "IVikuCL96uE", Episode = "01", Tab = "One Assistant, Four Websites",
            Title = "One AI Assistant that knows four websites",
            Summary = "See five imports from four websites become one curated catalogue that powers a citation-backed Assistant and model-free Website Search - while every site keeps its own repo and publishing pipeline.",
        },
        new {
            Id = "PUgUar95DL8", Episode = "02", Tab = "Build a Knowledge Base",
            Title = "Build a Gemini RAG knowledge base",
            Summary = "Start from a folder of documents and finish with a managed File Store that answers questions with citations you can inspect - previewed before anything is written, then indexed by durable background workers.",
        },
        new {
            Id = "3IgsKuAXxAA", Episode = "03", Tab = "Website to AI-Ready Markdown",
            Title = "Turn any website into clean, AI-ready Markdown",
            Summary = "Crawl a public website into a private Markdown workspace you can inspect and clean with repeatable transforms - so navigation, boilerplate and tracking URLs never reach your index, and only reviewed content is imported.",
        },
        new {
            Id = "erH8wqAoESI", Episode = "04", Tab = "Update Without Re-Embedding",
            Title = "Keep your index current without re-embedding everything",
            Summary = "Re-run a saved import and preview the exact delta before anything is written - unchanged documents are never embedded or locally indexed again, removals stay visible as tombstones, and an unexpectedly large one is refused.",
        },
        new {
            Id = "YKQPG6MpLKg", Episode = "05", Tab = "Metadata, Filters & Citations",
            Title = "Stop RAG answering from the wrong documents",
            Summary = "Set metadata and canonical Source URLs once at import, then scope what retrieval is allowed to read - so answers come back with citations that open the real public page, and the same filters are enforced on the server.",
        },
    };
}
@if (showVideos)
{
    <div class="mx-auto max-w-7xl px-6 pt-20 lg:px-8" id="rag-videos">
        <div class="mx-auto max-w-3xl text-center">
            <p class="font-mono text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Watch the series</p>
        </div>

        <div role="tablist" aria-label="Gemini RAG videos" class="mx-auto mt-6 flex max-w-5xl flex-wrap justify-center gap-2">
            @for (var i = 0; i < videos.Length; i++)
            {
                var v = videos[i];
                <button type="button" role="tab" id="rag-video-tab-@i" aria-controls="rag-video-panel-@i"
                        aria-selected="@(i == 0 ? "true" : "false")" tabindex="@(i == 0 ? "0" : "-1")"
                        class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold ring-1 transition-colors
                               text-slate-600 ring-slate-900/10 hover:text-slate-900 hover:ring-slate-900/20
                               dark:text-slate-400 dark:ring-white/10 dark:hover:text-white dark:hover:ring-white/20
                               aria-selected:bg-emerald-600 aria-selected:text-white aria-selected:ring-emerald-600
                               dark:aria-selected:bg-emerald-500 dark:aria-selected:text-white dark:aria-selected:ring-emerald-500">
                    <span class="font-mono text-xs opacity-70">@v.Episode</span>
                    <span>@v.Tab</span>
                </button>
            }
        </div>

        @for (var i = 0; i < videos.Length; i++)
        {
            var v = videos[i];
            <div role="tabpanel" id="rag-video-panel-@i" aria-labelledby="rag-video-tab-@i" class="@(i == 0 ? "" : "hidden")">
                <div class="mx-auto mt-8 max-w-3xl text-center">
                    <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">@v.Title</h2>
                    <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">@v.Summary</p>
                </div>
                <div class="mx-auto mt-10 w-full max-w-5xl overflow-hidden rounded-xl border border-slate-200 shadow-2xl dark:border-slate-700">
                    <lite-youtube class="block w-full aspect-video" videoid="@v.Id"
                                  style="max-width: none; background-image: url('https://img.youtube.com/vi/@v.Id/maxresdefault.jpg')">
                    </lite-youtube>
                </div>
            </div>
        }
    </div>

    <script>
    ;(function () {
        const tabs = Array.from(document.querySelectorAll('#rag-videos [role="tab"]'))
        if (tabs.length < 2) return

        function select(tab) {
            tabs.forEach(t => {
                const on = t === tab
                t.setAttribute('aria-selected', on ? 'true' : 'false')
                t.tabIndex = on ? 0 : -1
                const panel = document.getElementById(t.getAttribute('aria-controls'))
                panel.classList.toggle('hidden', !on)
                // Stop a playing video when its tab is left by resetting the lite-youtube poster
                if (!on) {
                    const yt = panel.querySelector('lite-youtube')
                    const iframe = yt && yt.querySelector('iframe')
                    if (iframe) { iframe.remove(); yt.classList.remove('lyt-activated') }
                }
            })
        }

        tabs.forEach((tab, i) => {
            tab.addEventListener('click', () => select(tab))
            tab.addEventListener('keydown', e => {
                const next = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0
                if (!next) return
                e.preventDefault()
                const to = tabs[(i + next + tabs.length) % tabs.length]
                select(to)
                to.focus()
            })
        })
    })()
    </script>
}

<!-- ───────────────────────── One import, two retrieval systems ───────────────────────── -->
<div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
        <p class="font-mono text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">The core idea</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
            One import. Two retrieval systems.
        </h2>
        <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">
            Every document you import is indexed twice - semantically by Gemini File Search, and as heading-aware
            full-text sections in your own database. Two very different jobs, one content pipeline to maintain.
        </p>
    </div>

    <div class="mx-auto mt-14 max-w-5xl">
        <div class="grid items-stretch gap-6 lg:grid-cols-[1fr_auto_1fr]">

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                <div class="font-mono text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500">Source</div>
                <h3 class="mt-2 text-lg font-bold text-slate-900 dark:text-white">Your content catalogue</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
                    Files, ZIPs, server folders and crawled websites - normalized, deduplicated by SHA-256, tagged
                    with metadata and stored in your App's database.
                </p>
                <ul class="mt-4 space-y-1.5 font-mono text-xs text-slate-500 dark:text-slate-400">
                    <li>ChatFilestore</li>
                    <li>ChatDocument</li>
                    <li>ChatSource</li>
                </ul>
            </div>

            <div class="flex items-center justify-center lg:w-24">
                <div class="grid w-full gap-8 lg:h-32 lg:content-center">
                    <div class="flow h-1 w-full rounded-full bg-slate-200 lg:h-0.5 dark:bg-slate-800"></div>
                    <div class="flow flow-b h-1 w-full rounded-full bg-slate-200 lg:h-0.5 dark:bg-slate-800"></div>
                </div>
            </div>

            <div class="grid gap-6">
                <div class="rounded-2xl border border-emerald-200 bg-emerald-50/50 p-6 dark:border-emerald-900/60 dark:bg-emerald-950/20">
                    <div class="font-mono text-[11px] font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Semantic</div>
                    <h3 class="mt-2 text-lg font-bold text-slate-900 dark:text-white">Gemini File Search</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
                        Meaning-based retrieval for grounded answers with citations. Powers chat and the
                        embeddable Website Assistant.
                    </p>
                </div>
                <div class="rounded-2xl border border-cyan-200 bg-cyan-50/50 p-6 dark:border-cyan-900/60 dark:bg-cyan-950/20">
                    <div class="font-mono text-[11px] font-bold uppercase tracking-widest text-cyan-600 dark:text-cyan-400">Lexical</div>
                    <h3 class="mt-2 text-lg font-bold text-slate-900 dark:text-white">Your RDBMS full-text index</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
                        Instant keyword search with no model in the path, no usage cost per query and no separate
                        search service to run.
                    </p>
                </div>
            </div>
        </div>

        <p class="mt-8 text-center text-sm leading-6 text-slate-500 dark:text-slate-400">
            Both indexes are maintained by durable background workers that compare a desired hash against a completed
            hash - so only genuinely changed documents are re-indexed, and pending work resumes after a restart.
        </p>
    </div>
</div>

<!-- ───────────────────────── Ingestion ───────────────────────── -->
<div class="border-y border-slate-200 bg-slate-50 py-20 dark:border-slate-800 dark:bg-slate-900/40">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            <p class="font-mono text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Ingestion</p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
                Three ways in, one catalogue
            </h2>
            <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">
                Whatever shape your knowledge is in today - a shared drive, a docs repo, or a website you don't own
                the source of - there's a path that doesn't require writing an indexer.
            </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
            <div class="rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L8 8m4-4l4 4M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
                    </svg>
                </div>
                <h3 class="mt-4 text-lg font-bold text-slate-900 dark:text-white">Upload files &amp; ZIPs</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
                    Drop in PDFs, Office documents, Markdown, HTML, CSV, JSON or YAML. A ZIP's folder structure
                    becomes browsable categories automatically.
                </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" />
                    </svg>
                </div>
                <h3 class="mt-4 text-lg font-bold text-slate-900 dark:text-white">Synchronize folders</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
                    Point at a documentation repo with include/exclude globs, category roots and metadata rules.
                    Save the import and re-run it whenever the source moves on.
                </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-9c2.5 2.5 3.5 5.8 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.8-3.5-9s1-6.5 3.5-9zM3.5 9h17M3.5 15h17" />
