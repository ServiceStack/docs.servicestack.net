<!-- ───────────────────────── Lightbox ───────────────────────── -->
<div id="ss-lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 p-4 backdrop-blur-sm sm:p-8" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button type="button" id="ss-lightbox-close" aria-label="Close (Esc)"
            class="absolute right-4 top-4 z-10 rounded-full p-2 text-white/80 transition hover:bg-white/10 hover:text-white">
        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <figure class="flex max-h-full max-w-7xl flex-col items-center gap-4">
        <img id="ss-lightbox-img" src="" alt="" class="max-h-[85vh] max-w-full rounded-lg object-contain shadow-2xl">
        <figcaption id="ss-lightbox-caption" class="text-center text-sm text-white/70"></figcaption>
    </figure>
</div>

<script>
;(function () {
    const box     = document.getElementById('ss-lightbox')
    const img     = document.getElementById('ss-lightbox-img')
    const caption = document.getElementById('ss-lightbox-caption')
    const closeEl = document.getElementById('ss-lightbox-close')
    const zoomable = Array.from(document.querySelectorAll('img.ss-zoom'))
    if (!box || !zoomable.length) return

    let lastFocus = null

    function open(el) {
        img.src = el.currentSrc || el.src
        img.alt = el.alt || ''
        caption.textContent = el.alt || ''
        box.classList.remove('hidden')
        box.classList.add('flex')
        document.body.style.overflow = 'hidden'
        lastFocus = document.activeElement
        closeEl.focus()
    }
    function close() {
        box.classList.add('hidden')
        box.classList.remove('flex')
        document.body.style.overflow = ''
        img.src = ''
        if (lastFocus && lastFocus.focus) lastFocus.focus()
    }

    zoomable.forEach(el => {
        el.addEventListener('click', () => open(el))
        el.setAttribute('role', 'button')
        el.setAttribute('tabindex', '0')
        el.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(el) }
        })
    })

    closeEl.addEventListener('click', close)
    box.addEventListener('click', e => { if (e.target === box || e.target.tagName === 'FIGURE') close() })
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && !box.classList.contains('hidden')) close()
    })
})()
</script>
