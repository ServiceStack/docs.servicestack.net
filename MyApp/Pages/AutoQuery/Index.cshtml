<script>
function aqCopy(id, btn) {
    const el = document.getElementById(id)
    if (!el) return
    navigator.clipboard.writeText(el.textContent.trim())
    const html = btn.innerHTML
    btn.innerHTML = '<svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>'
    setTimeout(() => btn.innerHTML = html, 1500)
}
const AQ_ON  = 'border-sky-500 bg-sky-50 text-sky-700 dark:bg-sky-950/50 dark:text-sky-300'
const AQ_OFF = 'border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 text-gray-600 dark:text-gray-400 hover:border-sky-300'
function aqTab(fw) {
    document.querySelectorAll('.aq-tab').forEach(b => {
        const on = b.dataset.fw === fw
        b.className = 'aq-tab inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-semibold transition ' + (on ? AQ_ON : AQ_OFF)
    })
    document.querySelectorAll('.aq-pane').forEach(p => p.classList.toggle('hidden', p.dataset.fw !== fw))
}
;(function () {
    aqTab('vue')
    const shots = Array.from(document.querySelectorAll('.aq-shot'))
    const url = document.getElementById('aq-url')
    if (shots.length < 2) return
    let i = 0
    if (url && shots[0].dataset.url) url.textContent = shots[0].dataset.url
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
    setInterval(() => {
        shots[i].style.opacity = '0'
        i = (i + 1) % shots.length
        shots[i].style.opacity = '1'
        if (url && shots[i].dataset.url) url.textContent = shots[i].dataset.url
    }, 4500)
})()
</script>

<script type="module">
import { mount } from "app.mjs"
import { ref, computed } from "vue"
import HighlightJson from "/pages/components/HighlightJson.mjs"

const bookingSchema = `{
  "name": "Booking",
  "primaryKey": "Id",
  "model":  { "type": "object", "properties": {} },
  "query":  { "$id": "/api/QueryBookings", "method": "GET" },
  "create": { "$id": "/api/CreateBooking", "method": "POST" },
  "update": { "$id": "/api/UpdateBooking", "method": "PATCH" },
  "delete": { "$id": "/api/DeleteBooking", "method": "DELETE" }
}`

// Every template below has AutoQuery pre-configured (empty + MQ Worker templates are excluded)
const TEMPLATE_GROUPS = [
    { name: 'React', color: 'bg-cyan-500', items: [
        { repo: 'react-spa',    desc: 'React Vite TypeScript SPA with Tailwind' },
        { repo: 'react-static', desc: 'React Vite Identity Auth with static export' },
        { repo: 'nextjs',       desc: 'Jamstack Next.js SSG React App' },
        { repo: 'next-rsc',     desc: 'Next.js React Server Components' },
        { repo: 'next-static',  desc: 'Next.js static export, Tailwind' },
    ]},
    { name: 'Vue', color: 'bg-emerald-500', items: [
        { repo: 'vue-spa',    desc: 'Vue Vite TypeScript SPA with Tailwind' },
        { repo: 'vue-static', desc: 'Jamstack Vue Vite App with Tailwind' },
    ]},
    { name: 'Blazor', color: 'bg-purple-500', items: [
        { repo: 'blazor',       desc: 'Blazor App with Tailwind' },
        { repo: 'blazor-vue',   desc: 'Blazor Vue App with Tailwind' },
        { repo: 'blazor-admin', desc: 'Blazor Admin Vue App with Tailwind' },
    ]},
    { name: 'Angular', color: 'bg-rose-500', items: [
        { repo: 'angular-spa', desc: 'Angular 21 App with Tailwind' },
    ]},
    { name: 'Razor Pages & MVC', color: 'bg-violet-500', items: [
        { repo: 'mvc',             desc: 'MVC Identity Auth App with Tailwind' },
        { repo: 'mvc-bootstrap',   desc: 'MVC Identity Auth App with Bootstrap' },
        { repo: 'razor',           desc: 'Razor Pages App with Tailwind' },
        { repo: 'razor-bootstrap', desc: 'Razor Pages App with Bootstrap' },
    ]},
]

const CreateProject = {
    template: `
    <div>
        <div class="grid gap-3 sm:grid-cols-[1.6fr_1fr]">
            <label class="block">
                <span class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-gray-500">Template</span>
                <select v-model="repo"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100">
                    <optgroup v-for="g in groups" :key="g.name" :label="g.name">
                        <option v-for="t in g.items" :key="t.repo" :value="t.repo">{{ t.repo }} — {{ t.desc }}</option>
                    </optgroup>
                </select>
            </label>
            <label class="block">
                <span class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-gray-500">Project name</span>
                <input v-model="project" type="text" spellcheck="false" autocorrect="off" placeholder="ProjectName"
                       class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 font-mono text-sm text-gray-900 shadow-sm placeholder-gray-400 focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100">
            </label>
        </div>

        <div class="mt-3 relative rounded-xl bg-slate-900 px-4 py-3.5 font-mono text-sm text-slate-200 overflow-x-auto">
            <span class="select-none text-emerald-400 mr-2">$</span><span class="whitespace-nowrap">npx create-net <span class="text-sky-300">{{ repo }}</span> <span class="text-amber-300">{{ projectName }}</span></span>
            <button type="button" v-on:click="copy" :aria-label="copied ? 'Copied' : 'Copy command'"
                    class="absolute right-2 top-1/2 -translate-y-1/2 rounded-lg p-2 text-slate-500 transition hover:bg-white/10 hover:text-white">
                <svg v-if="copied" class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <svg v-else class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </button>
        </div>

        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
            <span class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400">
                <span :class="['h-2 w-2 rounded-full', selected.color]"></span>
                {{ selected.desc }}
            </span>
            <a :href="'https://github.com/NetCoreTemplates/' + repo" class="text-sky-600 dark:text-sky-400 font-medium hover:text-sky-500">Source</a>
        </div>
    </div>`,
    setup() {
        const groups = TEMPLATE_GROUPS
        const repo = ref('react-spa')
        const project = ref('')
        const copied = ref(false)

        const projectName = computed(() => project.value.trim() || 'ProjectName')
        const selected = computed(() => {
            for (const g of groups) {
                const t = g.items.find(x => x.repo === repo.value)
                if (t) return { ...t, group: g.name, color: g.color }
            }
            return { desc: '', color: 'bg-gray-400' }
        })

        async function copy() {
            const cmd = `npx create-net ${repo.value} ${projectName.value}`
            try { await navigator.clipboard.writeText(cmd) } catch (err) { /* clipboard unavailable */ }
            copied.value = true
            setTimeout(() => copied.value = false, 2000)
        }

        return { groups, repo, project, projectName, selected, copied, copy }
    }
}

mount('#aq-create-project', CreateProject)

// Presentation for a JSON response; HighlightJson only colours the JSON itself
const SchemaCard = {
    props: { title: String },
    template: `
    <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 overflow-hidden shadow-lg">
        <div v-if="title" class="border-b border-gray-200 dark:border-gray-800 px-4 py-2.5 text-xs font-mono text-gray-500">{{ title }}</div>
        <pre class="p-5 text-sm leading-relaxed overflow-x-auto"><slot></slot></pre>
    </div>`
}

mount('#booking-schema', {
    components: { SchemaCard, HighlightJson },
    template: `<SchemaCard title="GET /auto/Booking.json"><HighlightJson :json="schema" /></SchemaCard>`,
    setup() {
        return { schema: bookingSchema }
    }
})
</script>
