@page "/add-servicestack-reference"
@attribute [RenderStatic]
@{
    ViewData["Title"] = "Add ServiceStack Reference";
    ViewData["Brand"] = "Native Types";
}

<link rel="stylesheet" href="/css/highlight.css">
<link rel="stylesheet" href="/css/lite-yt-embed.css">
<script src="/lib/js/lite-yt-embed.js"></script>

<style>
    /* highlight.css supplies the One Dark token palette (with !important), same as the reference
       page. Only the surface and spacing are overridden here - the panel already draws the dark
       background, and the component's v-html wrapper has no padding of its own. */
    #asr-langs pre { margin: 0; background: transparent }
    #asr-langs .hljs {
        display: block;
        overflow-x: auto;
        background: transparent !important;
        color: #e5e7eb !important;
        padding: 1.5rem 1.75rem !important;
        font-size: .875rem;
        line-height: 1.7142857;
    }
    #asr-langs .hljs-comment, #asr-langs .hljs-quote { color: rgb(148 163 184) !important }
    #asr-langs .hljs { scrollbar-width: thin; scrollbar-color: #45455e transparent }

    /* Fade the hero's language strip out at both edges */
    .asr-strip { -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
                 mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent) }
</style>

<!-- ───────────────────────── Hero ───────────────────────── -->
<section class="relative isolate overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_20%,rgba(79,70,229,.32),transparent_32%),radial-gradient(circle_at_80%_35%,rgba(6,182,212,.2),transparent_30%)]"></div>
    <div class="absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-indigo-400 to-transparent"></div>

    <div class="mx-auto max-w-7xl px-6 pb-20 pt-20 lg:px-8 lg:pt-28">
        <div class="mx-auto max-w-4xl text-center">
            <div class="inline-flex items-center gap-2 rounded-full border border-indigo-400/30 bg-indigo-400/10 px-4 py-2 text-sm font-semibold text-indigo-200">
                <span class="relative flex h-2 w-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-400 opacity-75"></span>
                    <span class="relative inline-flex h-2 w-2 rounded-full bg-cyan-400"></span>
                </span>
                Add ServiceStack Reference
            </div>

            <h1 class="mt-8 text-balance text-5xl font-black tracking-tight sm:text-7xl lg:text-8xl">
                One API.<br><span class="bg-gradient-to-r from-indigo-300 via-white to-cyan-300 bg-clip-text text-transparent">15 languages.</span>
            </h1>

            <p class="mx-auto mt-7 max-w-3xl text-pretty text-lg leading-8 text-slate-300 sm:text-xl">
                Define your contract once. Every developer gets clean native DTOs, an idiomatic feature-rich
                Service Client, editor completion and compile-time confidence &mdash; generated from a running API,
                not hand-written and left to drift.
            </p>

            <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
                <a href="#quickstart" class="rounded-full bg-white px-7 py-3.5 text-base font-bold text-slate-950 shadow-xl shadow-indigo-950 transition hover:bg-cyan-50">Generate your DTOs</a>
                <a href="#languages" class="rounded-full border border-white/20 px-7 py-3.5 text-base font-bold text-white transition hover:border-white/40 hover:bg-white/10">Explore all languages</a>
            </div>

            <div class="mx-auto mt-12 max-w-xl overflow-hidden rounded-2xl border border-white/10 bg-black/40 text-left shadow-2xl">
                <div class="flex items-center gap-2 border-b border-white/5 px-4 py-2.5">
                    <div class="h-2.5 w-2.5 rounded-full bg-red-500"></div>
                    <div class="h-2.5 w-2.5 rounded-full bg-amber-500"></div>
                    <div class="h-2.5 w-2.5 rounded-full bg-green-500"></div>
                    <div class="ml-2 font-mono text-xs text-slate-500">Terminal</div>
                </div>
                <pre class="!bg-transparent overflow-x-auto px-5 py-4 font-mono text-sm leading-7 text-slate-300"><code><span class="text-slate-500">$</span> npx get-dtos <span class="text-cyan-300">go</span> https://example.org
<span class="text-emerald-400">Saved to: dtos.go</span>

<span class="text-slate-500">$</span> npx get-dtos <span class="text-cyan-300">swift</span> https://example.org
<span class="text-emerald-400">Saved to: dtos.swift</span></code></pre>
            </div>
        </div>

        <!-- Language strip -->
        <div class="asr-strip mt-16 flex flex-wrap items-center justify-center gap-x-8 gap-y-6 opacity-90">
            @foreach (var (id, name, cls) in new[] {
                ("csharp","C#","w-9 h-9 object-contain"),
                ("fsharp","F#","w-9 h-9 object-contain"),
                ("vbnet","VB.NET","w-9 h-9 object-contain"),
                ("typescript","TypeScript","w-9 h-9 object-contain"),
                ("javascript","JavaScript","w-9 h-9 object-contain"),
                ("python","Python","w-9 h-9 object-contain"),
                ("php","PHP","w-12 h-9 object-contain"),
                ("ruby","Ruby","w-9 h-9 object-contain"),
                ("swift","Swift","w-9 h-9 object-contain"),
                ("java","Java","w-9 h-9 object-contain"),
                ("kotlin","Kotlin","w-9 h-9 object-contain"),
                ("dart","Dart","w-9 h-9 object-contain"),
                ("go","Go","w-14 h-9 object-contain"),
                ("rust","Rust","w-9 h-9 object-contain invert"),
                ("zig","Zig","w-9 h-9 object-contain") })
            {
                <img src="/img/langs/@(id).svg" alt="@name" title="@name" class="@cls" loading="lazy">
            }
        </div>

        <div class="mx-auto mt-16 grid max-w-4xl grid-cols-1 divide-y divide-white/10 rounded-2xl border border-white/10 bg-white/[.05] sm:grid-cols-3 sm:divide-x sm:divide-y-0">
            <div class="px-6 py-5 text-center"><div class="text-3xl font-black">15</div><div class="mt-1 text-sm text-slate-400">native integrations</div></div>
            <div class="px-6 py-5 text-center"><div class="text-3xl font-black">1</div><div class="mt-1 text-sm text-slate-400">source of truth</div></div>
            <div class="px-6 py-5 text-center"><div class="text-3xl font-black">0</div><div class="mt-1 text-sm text-slate-400">hand-written SDKs</div></div>
        </div>
    </div>
</section>

<!-- ───────────────────────── The contract is the product ───────────────────────── -->
<section class="bg-white py-24 dark:bg-black sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid items-start gap-16 lg:grid-cols-2">
            <div>
                <p class="text-sm font-bold uppercase tracking-[.2em] text-indigo-600 dark:text-indigo-400">The contract is the product</p>
                <h2 class="mt-4 text-balance text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">
                    Stop rebuilding the same API for every platform.
                </h2>
                <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
                    Your ServiceStack Request DTO already knows its response type, route, HTTP method, validation
                    and API metadata. Add ServiceStack Reference carries that intelligence into every client.
                </p>
                <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
                    The result feels hand-built in every language: native naming and types, discoverable contracts,
                    structured errors, authentication, AutoQuery, uploads, batch and one-way requests.
                </p>
                <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
                    There are no hand-written URLs, no anonymous JSON objects and no duplicated response models &mdash;
                    the generated file <em>is</em> the contract, and refreshing it is how you find out what changed.
                </p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl border border-slate-200 p-6 dark:border-slate-800 dark:bg-slate-900/60">
                    <div class="text-2xl">⌘</div>
                    <h3 class="mt-4 font-bold text-slate-950 dark:text-white">Native by design</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">Idiomatic DTOs and clients that belong in each ecosystem.</p>
                </div>
                <div class="rounded-2xl border border-slate-200 p-6 dark:border-slate-800 dark:bg-slate-900/60">
                    <div class="text-2xl">✓</div>
                    <h3 class="mt-4 font-bold text-slate-950 dark:text-white">Types end to end</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">Completion while you build. Compiler feedback when contracts change.</p>
                </div>
                <div class="rounded-2xl border border-slate-200 p-6 dark:border-slate-800 dark:bg-slate-900/60">
                    <div class="text-2xl">↻</div>
                    <h3 class="mt-4 font-bold text-slate-950 dark:text-white">Always in sync</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">Refresh one generated file whenever the API evolves.</p>
                </div>
                <div class="rounded-2xl border border-slate-200 p-6 dark:border-slate-800 dark:bg-slate-900/60">
                    <div class="text-2xl">⚡</div>
                    <h3 class="mt-4 font-bold text-slate-950 dark:text-white">Production capable</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">Auth, rich errors, queries and uploads without boilerplate.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ───────────────────────── Not another SDK project ───────────────────────── -->
<section class="border-y border-slate-200 bg-slate-50 py-24 dark:border-slate-800 dark:bg-slate-950 sm:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm font-bold uppercase tracking-[.2em] text-cyan-600 dark:text-cyan-400">A lighter approach</p>
            <h2 class="mt-4 text-balance text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">
                Add a reference, not another SDK project.
            </h2>
            <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
                Traditional SDK development multiplies work: every API change has to be reflected in docs, models and
                client code for each platform. Generated SDKs reduce that, but often bring large toolchains, verbose
                output and clients that feel foreign in the language using them.
            </p>
        </div>

        <div class="mx-auto mt-14 grid max-w-5xl gap-6 md:grid-cols-2">
            <div class="rounded-2xl border border-rose-200 bg-white p-7 dark:border-rose-900/50 dark:bg-slate-900">
                <div class="text-xs font-bold uppercase tracking-widest text-rose-600 dark:text-rose-400">The usual way</div>
                <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
                    <li class="flex gap-3"><span class="text-rose-500">✕</span><span>A separate SDK repo and release train per platform</span></li>
                    <li class="flex gap-3"><span class="text-rose-500">✕</span><span>A spec file kept in sync by hand</span></li>
                    <li class="flex gap-3"><span class="text-rose-500">✕</span><span>Heavyweight codegen toolchains in every build</span></li>
                    <li class="flex gap-3"><span class="text-rose-500">✕</span><span>Generated clients that feel foreign in their language</span></li>
                    <li class="flex gap-3"><span class="text-rose-500">✕</span><span>Server changes surfacing as runtime failures</span></li>
                </ul>
            </div>
            <div class="rounded-2xl border border-emerald-200 bg-white p-7 shadow-sm dark:border-emerald-900/50 dark:bg-slate-900">
                <div class="text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Add ServiceStack Reference</div>
                <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
                    <li class="flex gap-3"><span class="text-emerald-500">✓</span><span>One command against a running API</span></li>
                    <li class="flex gap-3"><span class="text-emerald-500">✓</span><span>A single generated source file per client</span></li>
                    <li class="flex gap-3"><span class="text-emerald-500">✓</span><span>Nothing to install or configure on the server</span></li>
                    <li class="flex gap-3"><span class="text-emerald-500">✓</span><span>Native naming, types and error handling</span></li>
                    <li class="flex gap-3"><span class="text-emerald-500">✓</span><span>Breaking changes caught by the language's own tools</span></li>
                </ul>
            </div>
        </div>

        <div class="mx-auto mt-14 max-w-4xl">
            <div class="grid gap-4 sm:grid-cols-4">
                <div class="rounded-2xl border border-slate-200 bg-white p-5 text-center dark:border-slate-800 dark:bg-slate-900">
                    <div class="mx-auto flex h-9 w-9 items-center justify-center rounded-full bg-indigo-50 font-black text-indigo-600 dark:bg-indigo-950 dark:text-indigo-300">1</div>
                    <p class="mt-3 text-sm font-semibold text-slate-900 dark:text-white">Define a typed Request DTO</p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-5 text-center dark:border-slate-800 dark:bg-slate-900">
                    <div class="mx-auto flex h-9 w-9 items-center justify-center rounded-full bg-indigo-50 font-black text-indigo-600 dark:bg-indigo-950 dark:text-indigo-300">2</div>
                    <p class="mt-3 text-sm font-semibold text-slate-900 dark:text-white">Implement it once on the server</p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-5 text-center dark:border-slate-800 dark:bg-slate-900">
                    <div class="mx-auto flex h-9 w-9 items-center justify-center rounded-full bg-indigo-50 font-black text-indigo-600 dark:bg-indigo-950 dark:text-indigo-300">3</div>
                    <p class="mt-3 text-sm font-semibold text-slate-900 dark:text-white">Refresh the reference in any client</p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-5 text-center dark:border-slate-800 dark:bg-slate-900">
                    <div class="mx-auto flex h-9 w-9 items-center justify-center rounded-full bg-indigo-50 font-black text-indigo-600 dark:bg-indigo-950 dark:text-indigo-300">4</div>
                    <p class="mt-3 text-sm font-semibold text-slate-900 dark:text-white">Call the API with native types</p>
                </div>
            </div>
            <p class="mt-6 text-center text-sm text-slate-500 dark:text-slate-400">
                No schema translation layer. No parallel SDK release train. No drift between a wiki and the API that's actually deployed.
            </p>
        </div>
    </div>
</section>

<!-- ───────────────────────── Quick start ───────────────────────── -->
<section id="quickstart" class="scroll-mt-20 bg-white py-24 dark:bg-black sm:py-32">
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="mx-auto max-w-4xl text-center">
            <p class="text-sm font-bold uppercase tracking-[.2em] text-cyan-600 dark:text-cyan-400">Two commands. Done.</p>
            <h2 class="mt-4 text-balance text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">
                From running API to native types in under a minute.
            </h2>
            <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
                Pick your language. Install its client. Generate the complete API contract directly into your project.
            </p>
        </div>

        <div id="dto-quickstart" class="mt-12"></div>

        <p class="mx-auto mt-8 max-w-2xl text-center text-sm leading-6 text-slate-500 dark:text-slate-400">
            Nothing needs to be installed or configured on the server &mdash; every ServiceStack App already publishes the
            metadata <code class="font-mono text-xs text-cyan-700 dark:text-cyan-400">get-dtos</code> reads. Run
            <code class="font-mono text-xs text-cyan-700 dark:text-cyan-400">npx get-dtos</code> with no arguments to
            list every supported language.
        </p>
    </div>
</section>

<!-- ───────────────────────── Languages ───────────────────────── -->
<section id="languages" class="scroll-mt-20 border-y border-slate-200 bg-slate-50 py-24 dark:border-slate-800 dark:bg-slate-950 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm font-bold uppercase tracking-[.2em] text-indigo-600 dark:text-indigo-400">From websites to systems software</p>
            <h2 class="mt-4 text-balance text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">
                Every language your organization builds with.
            </h2>
            <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
                A mobile team and a systems team don't need to agree on one programming language to share the same
                precise API contract.
            </p>
        </div>

        @{
            var groups = new (string Group, string Blurb, (string Id, string Name, string Slug, string Note, string LogoCss)[] Langs)[] {
                (".NET", "First-class typed clients for the .NET languages", new[] {
                    ("csharp", "C#", "csharp", "JsonApiClient", "h-10 w-10"),
                    ("fsharp", "F#", "fsharp", "Functional-first DTOs", "h-10 w-10"),
                    ("vbnet", "VB.NET", "vbnet", "Full .NET interop", "h-10 w-10"),
                }),
                ("Web & Scripting", "Websites, automations and internal systems", new[] {
                    ("typescript", "TypeScript", "typescript", "@servicestack/client", "h-10 w-10"),
                    ("javascript", "JavaScript", "javascript", "ES modules, no build step", "h-10 w-10"),
                    ("python", "Python", "python", "pip install servicestack", "h-10 w-10"),
                    ("php", "PHP", "php", "Composer package", "h-10 w-12"),
                    ("ruby", "Ruby", "ruby", "servicestack gem", "h-10 w-10"),
                }),
                ("Mobile", "Native apps on every major mobile platform", new[] {
                    ("swift", "Swift", "swift", "Swift Package Manager", "h-10 w-10"),
                    ("java", "Java", "java", "Android & JVM", "h-10 w-10"),
                    ("kotlin", "Kotlin", "kotlin", "Android & JVM", "h-10 w-10"),
                    ("dart", "Dart", "dart", "Flutter ready", "h-10 w-10"),
                }),
                ("Cloud & Systems", "Cloud services, tooling and native binaries", new[] {
                    ("go", "Go", "go", "servicestack-go", "h-10 w-14"),
                    ("rust", "Rust", "rust", "servicestack crate", "h-10 w-10 dark:invert"),
                    ("zig", "Zig", "zig", "servicestack-zig", "h-10 w-10"),
                }),
            };
        }

        <div class="mt-16 space-y-12">
            @foreach (var g in groups)
            {
                <div>
                    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-slate-200 pb-3 dark:border-slate-800">
                        <h3 class="text-xl font-black tracking-tight text-slate-950 dark:text-white">@g.Group</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400">@g.Blurb</p>
                    </div>
                    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
                        @foreach (var l in g.Langs)
                        {
                            <a href="/@(l.Slug)-add-servicestack-reference"
                               class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-indigo-300 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-700">
                                <img src="/img/langs/@(l.Id).svg" alt=""
                                     class="@l.LogoCss shrink-0 object-contain" loading="lazy">
                                <div class="min-w-0">
                                    <div class="font-bold text-slate-950 dark:text-white">@l.Name</div>
                                    <div class="truncate text-xs text-slate-500 dark:text-slate-400">@l.Note</div>
                                </div>
                                <svg class="ml-auto h-4 w-4 shrink-0 text-slate-300 transition group-hover:translate-x-0.5 group-hover:text-indigo-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.69l-3.22-3.22a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                                </svg>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <p class="mt-12 text-center text-sm text-slate-500 dark:text-slate-400">
            Also available: <a href="/commonjs-add-servicestack-reference" class="font-semibold text-indigo-600 hover:underline dark:text-indigo-400">ES3 CommonJS</a>
            for legacy JavaScript environments.
        </p>
    </div>
</section>

<!-- ───────────────────────── Live language switcher ───────────────────────── -->
<section id="chat-completion" class="bg-white py-24 dark:bg-black sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm font-bold uppercase tracking-[.2em] text-indigo-600 dark:text-indigo-400">A real contract, everywhere</p>
            <h2 class="mt-4 text-balance text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">
                The world's most important API, in every language.
            </h2>
            <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
                <code class="font-mono text-base">ChatCompletion</code> is not a trivial request &mdash; nested messages,
                polymorphic content, model settings and a rich response graph. Choose a language to see that entire
                contract as native code.
            </p>
        </div>
        <div id="asr-langs" class="mt-16"></div>
    </div>
</section>

<!-- ───────────────────────── Overview video ───────────────────────── -->
<section class="border-y border-indigo-400/20 bg-slate-950 py-20 text-white sm:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm font-bold uppercase tracking-[.2em] text-cyan-300">A better API architecture</p>
            <h2 class="mt-4 text-balance text-4xl font-black tracking-tight sm:text-5xl">
                One API. 15 Languages. Zero Hand-Written SDKs.
            </h2>
            <p class="mt-5 text-lg leading-8 text-slate-300">
                Define your contract once. Every developer gets clean native DTOs, an idiomatic feature-rich Service Client, 
                editor autocomplete, and compile-time confidence - generated directly from a running API, not hand-written 
                and left to drift.
            </p>
        </div>
        <div class="mx-auto mt-12 w-full max-w-5xl overflow-hidden rounded-xl border border-white/10 shadow-2xl shadow-indigo-950/50">
            <lite-youtube class="block w-full aspect-video" videoid="Rp9JIcNLdKQ"
                          style="max-width: none; background-image: url('https://img.youtube.com/vi/Rp9JIcNLdKQ/maxresdefault.jpg')">
            </lite-youtube>
        </div>
    </div>
</section>

<!-- ───────────────────────── One capability set ───────────────────────── -->
<section class="border-y border-slate-200 bg-slate-50 py-24 dark:border-slate-800 dark:bg-slate-950 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm font-bold uppercase tracking-[.2em] text-cyan-600 dark:text-cyan-400">More than data classes</p>
            <h2 class="mt-4 text-balance text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">
                One consistent capability set, expressed natively.
            </h2>
            <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
                The clients don't force one language's style everywhere. Go returns values and errors. Rust supports
