<script src="/lib/js/highlight.js"></script>
<script type="module">
import { mount } from "app.mjs"
import { onMounted, onUnmounted, reactive } from "vue"
import DtoQuickStart from "/pages/components/DtoQuickStart.mjs"
import OpenAiChatLangs from "/pages/components/OpenAiChatLangs.mjs"

mount('#dto-quickstart', {
    components: { DtoQuickStart },
    template: `<DtoQuickStart selected="typescript" url="https://example.org" />`,
})

mount('#asr-langs', {
    components: { OpenAiChatLangs },
    template: `
      <OpenAiChatLangs baseUrl="https://ai.llmspy.org" :routes="routes">
        <div class="lg:max-w-lg">
          <p class="text-sm font-bold uppercase tracking-[.18em] text-indigo-600 dark:text-indigo-400">Typed beyond transport</p>
          <h3 class="mt-3 text-3xl font-black tracking-tight text-slate-950 dark:text-white">This isn't just HTTP with nicer syntax.</h3>
          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
            The request knows its response, route and method. The client handles serialization, authentication
            and structured errors. Your editor understands the entire graph.
          </p>
          <ul class="mt-8 space-y-4 text-slate-700 dark:text-slate-300">
            <li class="flex gap-3"><span class="font-bold text-cyan-500">✓</span><span><b>Native DTOs</b> with rich API metadata</span></li>
            <li class="flex gap-3"><span class="font-bold text-cyan-500">✓</span><span><b>Generic typed clients</b> with a consistent capability set</span></li>
            <li class="flex gap-3"><span class="font-bold text-cyan-500">✓</span><span><b>No anonymous JSON</b>, duplicated models or hand-written URLs</span></li>
          </ul>
        </div>
      </OpenAiChatLangs>`,
    setup() {
        const getLang = () => new URLSearchParams(location.search).get('lang') || 'csharp'
        const routes = reactive({ lang: getLang() })
        const updateRoute = () => routes.lang = getLang()
        onMounted(() => window.addEventListener('popstate', updateRoute))
        onUnmounted(() => window.removeEventListener('popstate', updateRoute))
        return { routes }
    },
})
</script>
