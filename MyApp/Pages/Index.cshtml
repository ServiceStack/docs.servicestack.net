@page "/"
@attribute [RenderStatic]
@inject MarkdownPages Markdown
@{
    ViewData["Title"] = "ServiceStack Documentation";
}

@{
    Func<dynamic?, object> header =
        @<div class="mt-8">
            <div id="sections" class="max-w-7xl mx-auto scroll-mt-20">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <h2 class="text-3xl tracking-tight font-extrabold text-gray-900 dark:text-gray-50 sm:text-4xl">Browse the Docs</h2>
                    <a href="https://servicestack.net/whatsnew" class="group inline-flex items-center gap-x-3 self-start sm:self-auto rounded-lg border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-950 py-2 pl-2 pr-4 text-sm font-medium text-indigo-700 dark:text-indigo-300 transition-colors hover:border-indigo-500 dark:hover:border-indigo-400 hover:no-underline">
                        <span class="flex size-8 items-center justify-center rounded-md bg-indigo-100 dark:bg-indigo-900">
                            <!-- Heroicon name: outline/speakerphone -->
                            <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
                            </svg>
                        </span>
                        What's New in ServiceStack
                        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24">
                                <path d="M0 0h24v24H0z" fill="none" />
                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
                            </svg>
                        </span>
                    </a>
                </div>
                <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var item in SiteSections.All)
                    {
                        <a href="@item.Href" class="group flex gap-x-4 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 p-4 transition-colors hover:border-indigo-500 dark:hover:border-indigo-400 hover:no-underline">
                            <span class="flex size-12 flex-none items-center justify-center rounded-lg bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-300 group-hover:bg-indigo-100 dark:group-hover:bg-indigo-900 [&>svg]:size-7">@Html.Raw(item.Icon)</span>
                            <span class="min-w-0">
                                <span class="block font-semibold text-gray-900 dark:text-gray-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-300">@item.Text</span>
                                <span class="mt-1 block text-sm leading-6 text-gray-600 dark:text-gray-400">@item.Description</span>
                            </span>
                        </a>
                    }
                </div>
            </div>
        </div>;
}

@await Html.PartialAsync("DocsPage", new Shared.DocsPage
{
   Brand = "ServiceStack Documentation",
   Folder = "",
   Slug = "index",
   Header = header,
   DocClass = "mx-auto prose lg:prose-lg lg:max-w-5xl!",
   HideTitle = true,
   HideDocumentMap = true,
   DefaultMenu = new MarkdownMenu
   {
       Icon = Markdown.DefaultMenuIcon,
       Text = "Home",
       Link = "/",
   },
}.Init(this, Markdown))
