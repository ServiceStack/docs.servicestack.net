@page "/"
@attribute [RenderStatic]
@inject MarkdownPages Markdown
@{
    ViewData["Title"] = "ServiceStack Documentation";
}

@{
    Func<dynamic?, object> header =
        @<div class="mt-8">
            <div class="max-w-7xl mx-auto">
                <div class="p-2 rounded-lg bg-indigo-50 dark:bg-indigo-900 shadow-sm sm:p-3">
                    <div class="flex items-center justify-between flex-wrap">
                        <div class="w-0 flex-1 flex items-center">
                            <span class="flex p-2 rounded-lg bg-indigo-100 dark:bg-indigo-800 ml-2">
                                <!-- Heroicon name: outline/speakerphone -->
                                <svg class="h-6 w-6 text-indigo-600 dark:text-indigo-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
                                </svg>
                            </span>
                            <p class="ml-3 font-medium text-indigo-600 dark:text-indigo-300 truncate">
                                <span class="hidden md:inline"> Checkout What's New in ServiceStack! </span>
                            </p>
                        </div>
                        <div class="order-3 mt-2 flex-shrink-0 w-full sm:order-2 sm:mt-0 sm:w-auto mr-2">
                            <a href="https://servicestack.net/whatsnew" class="flex items-center justify-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-indigo-600 dark:text-indigo-300 bg-white dark:bg-gray-800 hover:bg-indigo-100 dark:hover:bg-indigo-800 hover:no-underline"> Learn more </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>;
}

@await Html.PartialAsync("DocsPage", new Shared.DocsPage
{
   Brand = "ServiceStack Documentation",
   Folder = "",
   Slug = "index",
   Header = header,
   DocClass = "mx-auto prose lg:prose-lg lg:max-w-5xl!",
   HideTitle = true,
   HideDocumentMap = true,
   DefaultMenu = new MarkdownMenu
   {
       Icon = Markdown.DefaultMenuIcon,
       Text = "Home",
       Link = "/",
   },
}.Init(this, Markdown))
