@page "/vue/"
@attribute [RenderStatic]
@inject MarkdownPages Markdown
@{
    ViewData["Title"] = "Vue";
    ViewData["Brand"] = "ServiceStack Vue";
}

@await Html.PartialAsync("VideoIncludes")
@await Html.PartialAsync("HighlightIncludes")

<section class="relative w-full overflow-hidden border-b border-white/10 bg-[#0A1120]">

    <!-- Background: gradient wash -->
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_20%_0%,rgba(65,184,131,0.18),transparent_60%),radial-gradient(ellipse_70%_60%_at_100%_100%,rgba(52,73,94,0.7),transparent_65%),linear-gradient(180deg,#0A1120_0%,#0B1B22_60%,#0A1120_100%)]"></div>

    <!-- Background: grid -->
    <div class="pointer-events-none absolute inset-0 opacity-[0.35]">
        <svg class="h-full w-full" aria-hidden="true">
            <defs>
                <pattern id="vue-hero-grid" width="56" height="56" patternUnits="userSpaceOnUse">
                    <path d="M56 0H0V56" fill="none" stroke="#41B883" stroke-width="1" opacity="0.12" />
                </pattern>
                <radialGradient id="vue-hero-fade" cx="50%" cy="0%" r="80%">
                    <stop offset="0%" stop-color="white" stop-opacity="1" />
                    <stop offset="100%" stop-color="white" stop-opacity="0" />
                </radialGradient>
                <mask id="vue-hero-mask">
                    <rect width="100%" height="100%" fill="url(#vue-hero-fade)" />
                </mask>
            </defs>
            <rect width="100%" height="100%" fill="url(#vue-hero-grid)" mask="url(#vue-hero-mask)" />
        </svg>
    </div>

    <!-- Background: ambient glows -->
    <div class="pointer-events-none absolute -top-24 left-1/4 h-[28rem] w-[28rem] rounded-full bg-[#41B883]/20 blur-[120px]"></div>
    <div class="pointer-events-none absolute -bottom-32 right-1/3 h-[26rem] w-[26rem] rounded-full bg-teal-400/10 blur-[120px]"></div>

    <!-- Background: Vue logo watermark -->
    <svg class="pointer-events-none absolute -right-24 top-8 h-[34rem] w-[34rem] opacity-[0.06]" viewBox="0 0 32 32" aria-hidden="true">
        <path fill="#41B883" d="M24.4 3.925H30l-14 24.15L2 3.925h10.71l3.29 5.6l3.22-5.6Z"></path>
        <path fill="#41B883" d="m2 3.925l14 24.15l14-24.15h-5.6L16 18.415L7.53 3.925Z"></path>
        <path fill="#35495E" d="M7.53 3.925L16 18.485l8.4-14.56h-5.18L16 9.525l-3.29-5.6Z"></path>
    </svg>

    <div class="relative mx-auto max-w-7xl px-6 pt-16 pb-20 lg:px-8 lg:pt-24 lg:pb-28">
