@page "/jobs/{slug?}"
@model MyApp.Page
@inject MarkdownPages Markdown
@implements IRenderStatic<MyApp.Page>

@functions {
    public List<Page> GetStaticProps(RenderContext ctx) =>
        ctx.Resolve<MarkdownPages>().GetVisiblePages("jobs", allDirectories:true).Map(page => new Page { Slug = page.Slug.RightPart('/') });
}

@await Html.PartialAsync("DocsPage", new Shared.DocsPage {
   Brand = "Background Jobs",
   Slug = Model.Slug,
   Folder = "jobs",
   DefaultMenu = new MarkdownMenu {
       Icon = Markdown.DefaultMenuIcon,
       Text = "Background Jobs",
       Link = "/jobs/",
   },
}.Init(this, Markdown))
